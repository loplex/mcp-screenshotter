<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cz.loplex.mcp</groupId>
        <artifactId>mcp-screenshotter-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>mcp-screenshotter-worker</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>

        <!-- JNA for AT-SPI2 and X11 Native Integration -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
        </dependency>

        <!-- OpenCV for fallback UI detection. Ships as its own trimmed lib/opencv-*.jar rather
             than bundled into this module's own jar - see packaging/pom.xml and the
             opencv.include.* properties (pom.xml) for why and how. -->
        <dependency>
            <groupId>org.openpnp</groupId>
            <artifactId>opencv</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit for Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
            </plugin>
            <!-- Just this module's mainClass - addClasspath/classpathPrefix (needed so the
                 plain thin jar maven-jar-plugin builds by default can still find its
                 dependencies at runtime) are common to server and worker alike, see pom.xml
                 pluginManagement. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>cz.loplex.mcp.screenshotter.worker.WorkerMainKt</mainClass>
                        </manifest>
                        <manifestEntries>
                            <!-- Lists EVERY arch variant regardless of which profile (or no profile at all)
                                 built this jar, so worker.jar's own MANIFEST.MF is byte-identical between the
                                 release matrix's x86_64 and aarch64 legs. Each build ships only ONE of these
                                 files (packaging/pom.xml trims org.openpnp:opencv down to just the running
                                 arch's native lib) - the JVM classloader silently skips a Class-Path entry that
                                 doesn't resolve to an existing file (verified: no warning, no error), so the
                                 absent entries here are just inert no-op references, not a bug.
                                 "linux-multiarch" (opencv.arch.suffix's default, pom.xml) is what a plain
                                 `mvn package` with no -Plinux-* profile produces - the command CI (ci.yml) and
                                 README's local build instructions both use - so it has to be listed here too,
                                 not just the two release-matrix profiles' arch-specific names; omitting it is
                                 exactly what caused nu.pattern.OpenCV to go unresolved (NoClassDefFoundError)
                                 on any unprofiled build. -->
                            <Class-Path>lib/opencv-${opencv.version}-linux-x86_64.jar lib/opencv-${opencv.version}-linux-arm64.jar lib/opencv-${opencv.version}-linux-multiarch.jar</Class-Path>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
