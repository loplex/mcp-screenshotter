<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cz.loplex.mcp</groupId>
    <artifactId>mcp-screenshotter-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <kotlin.compiler.jvmTarget>17</kotlin.compiler.jvmTarget>

        <!-- Reproducible Builds (https://maven.apache.org/guides/mini/guide-reproducible-builds.html):
             maven-jar-plugin/maven-resources-plugin stamp every archive entry they write with the
             wall-clock time of the build instead of anything tied to the source, so two builds of
             the exact same commit - e.g. the release workflow's x86_64/aarch64 matrix legs, which
             build server.jar and worker.jar from identical, arch-independent source - end up
             byte-different despite having byte-identical decompressed content. Pinning this
             property makes every archive-producing plugin below use it instead, so identical
             sources always produce identical jars regardless of when/where they're built. Set to
             the last commit's timestamp (via git-commit-id-maven-plugin below, per the guide above)
             rather than a hardcoded date, so it moves forward on its own as the repo changes
             instead of needing a manual bump; it still stays fixed for any given commit, which is
             all reproducibility across the two matrix legs actually requires - both legs build the
             same tag.

             Archive timestamps aren't the only way the two matrix legs can end up byte-different,
             though: worker.jar's own MANIFEST.MF used to embed the arch-specific trimmed OpenCV
             jar's filename (opencv.arch.suffix) directly into its Class-Path entry, which made that
             entry - and so worker.jar itself - differ between legs even with this timestamp pinned.
             See worker/pom.xml's Class-Path comment for the fix (listing both arch variants
             literally, relying on the JVM silently skipping whichever one a given bundle doesn't
             actually ship). -->
        <project.build.outputTimestamp>&#36;{git.commit.time}</project.build.outputTimestamp>

        <git-commit-id-maven-plugin.version>10.0.0</git-commit-id-maven-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>

        <kotlin.version>2.4.10</kotlin.version>
        <jackson.version>3.2.0</jackson.version>
        <jna.version>5.14.0</jna.version>
        <opencv.version>4.7.0-0</opencv.version>
        <junit.version>5.10.2</junit.version>

        <opencv.native.include>nu/pattern/opencv/linux/**</opencv.native.include>
        <opencv.arch.suffix>multiarch</opencv.arch.suffix>
    </properties>

    <modules>
        <module>server</module>
        <module>worker</module>
        <module>packaging</module>
    </modules>

    <profiles>
        <profile>
            <id>linux-x86_64</id>
            <properties>
                <opencv.native.include>nu/pattern/opencv/linux/x86_64/**</opencv.native.include>
                <opencv.arch.suffix>x86_64</opencv.arch.suffix>
            </properties>
        </profile>
        <profile>
            <id>linux-aarch64</id>
            <properties>
                <opencv.native.include>nu/pattern/opencv/linux/ARMv8/**</opencv.native.include>
                <opencv.arch.suffix>arm64</opencv.arch.suffix>
            </properties>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-bom</artifactId>
                <version>${kotlin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna-platform</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openpnp</groupId>
                <artifactId>opencv</artifactId>
                <version>${opencv.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                    <configuration>
                        <jvmTarget>${maven.compiler.target}</jvmTarget>
                    </configuration>
                    <executions>
                        <execution>
                            <id>compile</id>
                            <phase>compile</phase>
                            <goals>
                                <goal>compile</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>test-compile</id>
                            <phase>test-compile</phase>
                            <goals>
                                <goal>test-compile</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>default-jar</id>
                            <configuration>
                                <archive>
                                    <manifest>
                                        <addClasspath>true</addClasspath>
                                        <classpathPrefix>lib/</classpathPrefix>
                                    </manifest>
                                </archive>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- Real (inherited) plugin, not pluginManagement - Maven inherits actual <plugins>
             entries from a parent into every child module's own build, so this runs once per
             module (root, server, worker, packaging), each resolving the same commit's timestamp
             independently, rather than needing to be repeated in every module's own pom.xml. Bound
             to its default "initialize" phase, well before any module's "package"-phase
             maven-jar-plugin execution reads project.build.outputTimestamp above, so git.commit.time
             is already populated by the time it's needed. dateFormat is overridden because the
             plugin's own default ("yyyy-MM-dd'T'HH:mm:ssZ", e.g. "+0100") isn't the ISO-8601 variant
             ("+01:00"/"Z") Maven's outputTimestamp parser accepts - see
             https://github.com/git-commit-id/git-commit-id-maven-plugin/issues/674. -->
        <plugins>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>${git-commit-id-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>get-git-commit-time</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <dateFormat>yyyy-MM-dd'T'HH:mm:ssXXX</dateFormat>
                    <dateFormatTimeZone>UTC</dateFormatTimeZone>
                    <generateGitPropertiesFile>false</generateGitPropertiesFile>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
