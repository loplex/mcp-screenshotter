<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cz.loplex.mcp</groupId>
    <artifactId>mcp-screenshotter-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <kotlin.compiler.jvmTarget>17</kotlin.compiler.jvmTarget>

        <!-- Reproducible Builds (https://maven.apache.org/guides/mini/guide-reproducible-builds.html):
             maven-jar-plugin/maven-resources-plugin stamp every archive entry they write with the
             wall-clock time of the build instead of anything tied to the source, so two builds of
             the exact same commit - e.g. the release workflow's x86_64/aarch64 matrix legs, which
             build server.jar and worker.jar from identical, arch-independent source - end up
             byte-different despite having byte-identical decompressed content. Pinning this
             property makes every archive-producing plugin below use it instead, so identical
             sources always produce identical jars regardless of when/where they're built. Set to
             the last commit's timestamp (via git-commit-id-maven-plugin below, per the guide above)
             rather than a hardcoded date, so it moves forward on its own as the repo changes
             instead of needing a manual bump; it still stays fixed for any given commit, which is
             all reproducibility across the two matrix legs actually requires - both legs build the
             same tag. -->
        <project.build.outputTimestamp>&#36;{git.commit.time}</project.build.outputTimestamp>

        <git-commit-id-maven-plugin.version>10.0.0</git-commit-id-maven-plugin.version>
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>

        <kotlin.version>2.4.10</kotlin.version>
        <jackson.version>3.2.0</jackson.version>
        <jna.version>5.14.0</jna.version>
        <opencv.version>4.7.0-0</opencv.version>
        <junit.version>5.10.2</junit.version>

        <!-- org.openpnp:opencv bundles a native library for every OS/arch it supports in one
             jar (Windows, macOS, and three Linux archs), but this app is Linux-only (see
             worker/pom.xml's JNA/AT-SPI2/X11 dependencies) and nu.pattern.OpenCV.loadLocally()
             only ever extracts the one native lib matching the running JVM's os.name/os.arch -
             the rest is 100% dead weight. packaging/pom.xml unpacks OpenCV through an allowlist
             (only these two properties, plus its Java API classes) rather than a denylist of
             unwanted platforms, on purpose: an allowlist fails closed - a future opencv release
             adding a new platform directory (say, linux/riscv64) is simply not on the list and
             stays out automatically, where a denylist would let it silently back in. These two
             properties are that allowlist's only variable part - which Linux arch(es) actually
             end up in the shipped lib/opencv-*.jar - real paths by default (a plain local
             `mvn package`, e2e tests, gets both archs and works on either machine); the
             linux-x86_64/linux-aarch64 profiles below null one of the two out (to
             "SKIP_NOTHING", which matches no real path in the jar) so a release build ships a
             single-arch opencv jar instead of a dual-arch one. Declared at the root, not in
             worker/pom.xml (which owns the actual dependency), because packaging/pom.xml - a
             sibling module, not worker's descendant - is what references them, and Maven
             properties aren't visible across sibling modules, only down a parent chain. -->
        <opencv.include.linuxX86_64>nu/pattern/opencv/linux/x86_64/**</opencv.include.linuxX86_64>
        <opencv.include.linuxAarch64>nu/pattern/opencv/linux/ARMv8/**</opencv.include.linuxAarch64>
    </properties>

    <modules>
        <module>server</module>
        <module>worker</module>
        <module>packaging</module>
    </modules>

    <profiles>
        <profile>
            <id>linux-x86_64</id>
            <properties>
                <opencv.include.linuxAarch64>nu/pattern/opencv/SKIP_NOTHING/**</opencv.include.linuxAarch64>
            </properties>
        </profile>
        <profile>
            <id>linux-aarch64</id>
            <properties>
                <opencv.include.linuxX86_64>nu/pattern/opencv/SKIP_NOTHING/**</opencv.include.linuxX86_64>
            </properties>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-bom</artifactId>
                <version>${kotlin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>net.java.dev.jna</groupId>
                <artifactId>jna-platform</artifactId>
                <version>${jna.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openpnp</groupId>
                <artifactId>opencv</artifactId>
                <version>${opencv.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                    <configuration>
                        <jvmTarget>${maven.compiler.target}</jvmTarget>
                    </configuration>
                    <executions>
                        <execution>
                            <id>compile</id>
                            <phase>compile</phase>
                            <goals>
                                <goal>compile</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>test-compile</id>
                            <phase>test-compile</phase>
                            <goals>
                                <goal>test-compile</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                    <configuration>
                        <!-- server and worker both ship as thin jars now - their own compiled
                             classes only, no bundled dependencies - next to a shared lib/
                             directory of plain (unmodified) dependency jars, assembled by
                             packaging/pom.xml. addClasspath/classpathPrefix here is what makes
                             `java -jar mcp-screenshotter-server.jar` still find them: it writes
                             a Class-Path entry (e.g. "lib/kotlin-stdlib-2.4.10.jar") into
                             META-INF/MANIFEST.MF for every one of the module's own runtime
                             dependencies, resolved relative to the jar's own location - not the
                             process's working directory - so it keeps working no matter where
                             `java -jar` is invoked from. Each module still supplies its own
                             mainClass (see server/pom.xml, worker/pom.xml). -->
                        <archive>
                            <manifest>
                                <addClasspath>true</addClasspath>
                                <classpathPrefix>lib/</classpathPrefix>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- Real (inherited) plugin, not pluginManagement - Maven inherits actual <plugins>
             entries from a parent into every child module's own build, so this runs once per
             module (root, server, worker, packaging), each resolving the same commit's timestamp
             independently, rather than needing to be repeated in every module's own pom.xml. Bound
             to its default "initialize" phase, well before any module's "package"-phase
             maven-jar-plugin execution reads project.build.outputTimestamp above, so git.commit.time
             is already populated by the time it's needed. dateFormat is overridden because the
             plugin's own default ("yyyy-MM-dd'T'HH:mm:ssZ", e.g. "+0100") isn't the ISO-8601 variant
             ("+01:00"/"Z") Maven's outputTimestamp parser accepts - see
             https://github.com/git-commit-id/git-commit-id-maven-plugin/issues/674. -->
        <plugins>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>${git-commit-id-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>get-git-commit-time</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <dateFormat>yyyy-MM-dd'T'HH:mm:ssXXX</dateFormat>
                    <dateFormatTimeZone>UTC</dateFormatTimeZone>
                    <generateGitPropertiesFile>false</generateGitPropertiesFile>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
