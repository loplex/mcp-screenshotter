<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cz.loplex.mcp</groupId>
        <artifactId>mcp-screenshotter-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>mcp-screenshotter-packaging</artifactId>
    <packaging>pom</packaging>

    <dependencies>
        <dependency>
            <groupId>cz.loplex.mcp</groupId>
            <artifactId>mcp-screenshotter-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cz.loplex.mcp</groupId>
            <artifactId>mcp-screenshotter-worker</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openpnp</groupId>
            <artifactId>opencv</artifactId>
        </dependency>
    </dependencies>

    <build>
        <outputDirectory>${project.build.directory}</outputDirectory>
        <resources>
            <resource>
                <directory>${project.basedir}/..</directory>
                <includes>
                    <include>README.md</include>
                    <include>CONTRIBUTING.md</include>
                    <include>LICENSE</include>
                </includes>
                <targetPath>mcp-screenshotter</targetPath>
            </resource>
        </resources>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-resources</id>
                        <goals>
                            <goal>resources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-own-jars</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/mcp-screenshotter</outputDirectory>
                            <excludeTransitive>true</excludeTransitive>
                            <excludeArtifactIds>opencv</excludeArtifactIds>
                            <stripVersion>true</stripVersion>
                        </configuration>
                    </execution>

                    <execution>
                        <id>copy-shared-libs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/mcp-screenshotter/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <excludeGroupIds>cz.loplex.mcp</excludeGroupIds>
                            <excludeArtifactIds>opencv</excludeArtifactIds>
                        </configuration>
                    </execution>

                    <execution>
                        <id>unpack-opencv-native</id>
                        <phase>package</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/opencv-native</outputDirectory>
                            <includeArtifactIds>opencv</includeArtifactIds>
                            <includes>META-INF/**,nu/pattern/*,org/opencv/**,${opencv.native.include}</includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repack-opencv-native</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>linux-${opencv.arch.suffix}</classifier>
                            <classesDirectory>${project.build.directory}/opencv-native</classesDirectory>
                            <outputDirectory>${project.build.directory}/mcp-screenshotter/lib</outputDirectory>
                            <finalName>opencv-${opencv.version}</finalName>
                            <archive>
                                <addMavenDescriptor>false</addMavenDescriptor>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
